# ============================================
# Worker Environment Variables
# ============================================
# Copy this file to .env.dev (or .env for legacy support)
# Required variables must be set, optional variables have defaults

# --------------------------------------------
# Application Configuration
# --------------------------------------------

# Environment: development, staging, production, or test
# Default: development
NODE_ENV=development


# Log level: fatal, error, warn, info, debug, trace, or silent
# Required: Yes
LOG_LEVEL=info

# HTTP server port
# Default: 8081
PORT=8081

# --------------------------------------------
# Database Configuration
# --------------------------------------------

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Required: Yes
# Example: postgresql://postgres:password@localhost:5432/api_db
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --------------------------------------------
# AWS Configuration (Required for production/staging/lambda mode)
# --------------------------------------------

# AWS region (e.g., us-east-1, eu-west-3)
REGION=eu-west-3

# SQS queue URL for job processing
# Example: https://sqs.eu-west-3.amazonaws.com/123456789012/worker-queue
SQS_QUEUE_URL=

# Lambda function ARN (for EventBridge cron scheduling)
# Example: arn:aws:lambda:eu-west-3:123456789012:function:worker-prod
LAMBDA_ARN=
